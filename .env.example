# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Google OAuth client must have Google Business Profile APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Places API key (used for landing page business search + public review preview)
GOOGLE_MAPS_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# StreamPay (https://app.streampay.sa/settings/api-keys)
STREAM_API_KEY=
STREAM_API_SECRET=
# Product UUIDs — create these as recurring monthly products in StreamPay dashboard
STREAM_PRODUCT_LOCAL_BUSINESS=
STREAM_PRODUCT_MULTI_LOCATION=
STREAM_PRODUCT_AGENCY_MAX=
