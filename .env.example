# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google OAuth client must have Google Business Profile APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places API key (used for landing page business search + public review preview)
GOOGLE_MAPS_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# MiniMax (for Reviews Analysis Reports)
MINIMAX_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# For local dev: stripe listen --forward-to localhost:3000/api/subscription/webhook
# then copy the whsec_ value it prints into STRIPE_WEBHOOK_SECRET
